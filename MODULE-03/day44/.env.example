# Addis Eats — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env*.local` is gitignored, so personal values never get committed.

# Google Analytics measurement ID used by the gtag script in src/app/layout.jsx.
# Leave it unset and the app falls back to the "G-DEMO0000000" placeholder.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Absolute site URL used as Next.js `metadataBase` for canonical and
# Open Graph URLs. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://addis-eats.example.com
